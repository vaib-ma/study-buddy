{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://study-buddy.local/schema/question.schema.json",
  "title": "Study Buddy Question",
  "type": "object",
  "required": ["question_id", "exam", "exam_year", "subject", "chapter", "topic", "difficulty", "question_type", "question_text", "correct_answer", "marks", "negative_marks", "source"],
  "properties": {
    "question_id": {"type": "string", "pattern": "^[A-Z0-9-]+-[0-9]{4}-[0-9]{6}$"},
    "exam": {"type": "string", "enum": ["JEE Main", "JEE Advanced", "KCET", "MHT-CET", "BITSAT", "GAKAO", "SAT"]},
    "exam_year": {"type": "integer", "minimum": 2000, "maximum": 2100},
    "subject": {"type": "string", "enum": ["Physics", "Chemistry", "Mathematics", "SAT Math", "SAT Reading and Writing"]},
    "chapter": {"type": "string", "minLength": 1},
    "topic": {"type": "string", "minLength": 1},
    "difficulty": {"type": "string", "enum": ["Easy", "Medium", "Hard"]},
    "question_type": {"type": "string", "enum": ["MCQ", "Multiple Correct", "Numerical", "Integer", "Assertion Reason", "Grid-In"]},
    "question_text": {"type": "string", "minLength": 1},
    "options": {"type": "array", "items": {"type": "string"}},
    "correct_answer": {"type": "string", "minLength": 1},
    "marks": {"type": "number"},
    "negative_marks": {"type": "number", "minimum": 0},
    "source": {"type": "string", "minLength": 1},
    "source_reference": {"type": "string"},
    "tags": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
